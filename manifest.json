{
  "manifest_version": 3,
  "name": "抖音千川素材编导 Agent",
  "short_name": "千川编导",
  "version": "0.3.1",
  "description": "专为抖音千川素材编导打造的开源侧边栏扩展：从商品 Brief 与历史复盘生成单变量策略、脚本、分镜和拍摄任务。",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage"],
  "optional_host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "打开千川素材编导"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "homepage_url": "https://github.com/3132882323-cyber/douyin-qianchuan-creative-director-agent"
}
